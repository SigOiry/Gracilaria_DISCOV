data = Full_df, family = Beta(), cores = 8, iter = 1000,
warmup = 100, control = list(adapt_delta = 0.9999),
save_pars = save_pars(latent = TRUE),
file = "Data/Model/Pred_Beta_agg_1000_DEM_SlopeCat_reSite_resampled")
